# 이 파일을 .env 로 복사해서 사용한다. .env 는 커밋하지 않는다.
APP_ENV=local

# PostgreSQL (docker compose 기본값과 동일)
POSTGRES_USER=youthfit
POSTGRES_PASSWORD=youthfit
POSTGRES_DB=youthfit
POSTGRES_PORT=5432
# localhost 대신 127.0.0.1: compose 가 IPv4 에만 바인딩해서 Windows 의 ::1 우선 시도가 타임아웃난다
DATABASE_URL=postgresql+asyncpg://youthfit:youthfit@127.0.0.1:5432/youthfit

# 브라우저 허용 출처 (쉼표 구분). Vercel 프리뷰처럼 주소가 바뀌면 정규식 사용
CORS_ORIGINS=http://localhost:3000
CORS_ORIGIN_REGEX=

# 역질문 세션 보관 일수 (일 배치가 이보다 오래된 세션을 삭제)
SESSION_RETENTION_DAYS=30

# 2차 Build 이후 사용 (발급 후 입력)
ONTONG_YOUTH_API_KEY=

# 비워 두면 LLM 없이 템플릿 문구로 응답한다
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# 재시도와 재시도 대기를 포함한 전체 시간 한도(초)
LLM_TIMEOUT_SEC=15
LLM_MAX_RETRIES=1
LLM_MAX_OUTPUT_TOKENS=2000
